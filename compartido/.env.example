# Copiar a compartido/.env (excluido de Git). Proyecto de Compose compartido (T08).
# Sin claves: el servicio de modelos y GROBID no usan secretos.

# Puertos publicados solo en 127.0.0.1 del servidor
PUERTO_MODELOS=8001
PUERTO_GROBID=8070

# Servicio de modelos: textos por pasada, inferencias simultáneas e hilos de PyTorch
# (0 = valor por defecto de la biblioteca)
TAMANO_LOTE=16
MAX_CONCURRENCIA=1
HILOS_INFERENCIA=0
