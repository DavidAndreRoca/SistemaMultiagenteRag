# Copiar a .env y completar. .env esta excluido de Git (RNF-16).
# Nunca escribir valores reales en este archivo.

# --- Entorno: desarrollo | pruebas | produccion ---
ENTORNO=desarrollo

# --- Compose (cada integrante usa nombre y puertos distintos en el servidor compartido) ---
COMPOSE_PROJECT_NAME=sma_rag
PUERTO_BD=5432
PUERTO_API=8000
POSTGRES_USER=sma
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=sma

# --- Obligatorias en todos los entornos ---
# Dentro de Compose el servidor de base se llama "bd".
URL_BD=postgresql+psycopg://sma:cambiar_esta_clave@bd:5432/sma
# Al menos 32 caracteres aleatorios (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRETO_SESION=

# --- Obligatoria en desarrollo y produccion (Crossref y Unpaywall, modo polite) ---
CORREO_POLITE=

# --- Obligatoria en produccion; en desarrollo solo la exige el comando de diagnostico ---
CLAVE_OPENALEX=

# --- Modelos de lenguaje de desarrollo (D-06). Solo el comando de diagnostico exige CLAVE_GROQ ---
CLAVE_GROQ=
CLAVE_DEEPSEEK=
CLAVE_GEMINI=

# --- Servicio compartido de modelos (T08; compartido/docker-compose.yml) ---
# Opcional hasta T10. Desde un contenedor unido a la red sma_compartido: http://servicio_modelos:8000
# Desde el anfitrion: http://127.0.0.1:8001. Sus propios ajustes van en compartido/.env.
URL_SERVICIO_MODELOS=

# --- Canal de extraccion de PDF (T09). Opcionales hasta T10 ---
# GROBID del proyecto compartido: http://grobid:8070 en la red sma_compartido, o
# http://127.0.0.1:8070 desde el anfitrion.
URL_GROBID=
# Carpeta con el modelo de diseno de pagina de Docling y el tokenizador de bge-m3
# (python -m app.corpus.recursos la llena y verifica las huellas). En Compose: /recursos.
DIRECTORIO_RECURSOS_CORPUS=
# Carpeta privada de los PDF del corpus (T10); nunca se sirve. En Compose: /archivos.
DIRECTORIO_ARCHIVOS=
